{
  "$comment": "Single source of truth for the Varense landing page. Generate CSS custom properties, a Tailwind theme, or a TS const from this file at build time — do not re-type these values into components.",
  "meta": {
    "name": "Varense Landing",
    "version": "1.0.0",
    "colorMode": "dark-only",
    "basis": "Sampled from the live Varense dashboard at /app"
  },

  "color": {
    "bg": {
      "base":   { "value": "#0C0908", "use": "page canvas, deepest layer" },
      "raised": { "value": "#0E0B09", "use": "alternating section bands, app chrome" },
      "panel":  { "value": "#100C0A", "use": "cards, tiles, the dashboard plate" },
      "inset":  { "value": "#16110D", "use": "inputs, metric wells inside a panel" }
    },
    "line": {
      "subtle":      { "value": "#1C1611", "use": "section band boundaries" },
      "default":     { "value": "#241D16", "use": "card borders, dividers, table rules" },
      "strong":      { "value": "#2A221B", "use": "input borders, plate outline" },
      "interactive": { "value": "#352C24", "use": "secondary button border, rest state" },
      "hover":       { "value": "#6B5A4A", "use": "secondary button border, hover state" }
    },
    "text": {
      "primary":   { "value": "#F6F1EA", "use": "headlines" },
      "body":      { "value": "#EFE7DE", "use": "default body, nav brand" },
      "secondary": { "value": "#C9BFB3", "use": "secondary button labels, emphasised data" },
      "muted":     { "value": "#A79A8D", "use": "lead paragraphs" },
      "dim":       { "value": "#8E8175", "use": "body paragraphs inside cards" },
      "faint":     { "value": "#7C6E62", "use": "metric tile labels" },
      "ghost":     { "value": "#6E6055", "use": "mono captions, chart legends, disabled" },
      "quiet":     { "value": "#4A3F35", "use": "footer column headings, copyright" }
    },
    "accent": {
      "mint":       { "value": "#4FD8A0", "use": "primary action, positive metrics, active state" },
      "mintHover":  { "value": "#7FE8BC", "use": "primary action hover" },
      "mintDeep":   { "value": "#2E9B72", "use": "logo gradient terminus" },
      "mintBorder": { "value": "#2E5E4B", "use": "border on the featured pricing tier" }
    },
    "signal": {
      "negative":     { "value": "#E0555A", "use": "VaR, CVaR, drawdown, loss" },
      "negativeDeep": { "value": "#6E2E31", "use": "gradient origin on loss bars" },
      "warning":      { "value": "#D9A441", "use": "max drawdown, caution thresholds, 'you are here'" },
      "warningDeep":  { "value": "#6B5220", "use": "gradient origin on caution bars" }
    },
    "chart": {
      "neutral100": { "value": "#4A3F35" },
      "neutral200": { "value": "#3A3129" },
      "neutral300": { "value": "#2E2620" },
      "$comment": "Histogram bodies and scatter dots. Descending = darker."
    },
    "alpha": {
      "scrim":       { "value": "rgba(12,9,8,0.78)", "use": "scrolled nav background, sits under a blur" },
      "mintWash":    { "value": "rgba(79,216,160,0.05)", "use": "insight callout background" },
      "mintGlow":    { "value": "rgba(79,216,160,0.09)", "use": "final CTA radial bloom" },
      "innerLight":  { "value": "rgba(255,255,255,0.04)", "use": "top inner highlight on the plate" }
    }
  },

  "font": {
    "display": {
      "family": "Newsreader",
      "fallback": "Georgia, 'Times New Roman', serif",
      "weights": [200, 300],
      "italic": true,
      "source": "Google Fonts (variable, opsz 6..72)",
      "use": "Every headline and every large number. Weight 200 at display sizes, 300 below 32px."
    },
    "heroHeadline": {
      "family": "Lora",
      "fallback": "Georgia, 'Times New Roman', serif",
      "weights": [400],
      "source": "Google Fonts (self-hosted via @fontsource/lora, matching how Newsreader is loaded)",
      "use": "Hero H1 base text only (type.displayXLHero) — a one-off swap from the display family. The emphasised word inside that H1 stays on font.display/Newsreader, overridden explicitly in Hero.jsx since it no longer matches its parent's family."
    },
    "body": {
      "family": "IBM Plex Sans",
      "fallback": "system-ui, -apple-system, sans-serif",
      "weights": [300, 400, 500],
      "source": "Google Fonts",
      "use": "Prose. Default weight is 300 — the page reads light on purpose."
    },
    "mono": {
      "family": "IBM Plex Mono",
      "fallback": "ui-monospace, SFMono-Regular, monospace",
      "weights": [400, 500],
      "source": "Google Fonts",
      "use": "All labels, all numeric data, all buttons, all nav. Carries the instrument feel."
    }
  },

  "type": {
    "$comment": "size is a CSS length or clamp(); tracking is letter-spacing; leading is line-height.",
    "displayXL":   { "font": "display", "size": "clamp(46px, 6.4vw, 94px)", "weight": 200, "leading": 1.0,  "tracking": "-0.025em", "use": "hero h1" },
    "displayXLHero": { "font": "heroHeadline", "size": "clamp(46px, 6.4vw, 94px)", "weight": 400, "leading": 1.0, "tracking": "-0.025em", "use": "hero h1 base text — same metrics as displayXL, Lora instead of Newsreader. See font.heroHeadline." },
    "displayL":    { "font": "display", "size": "clamp(38px, 5vw, 70px)",   "weight": 200, "leading": 1.08, "tracking": "-0.025em", "use": "final CTA h2" },
    "displayM":    { "font": "display", "size": "clamp(34px, 4vw, 58px)",   "weight": 200, "leading": 1.12, "tracking": "-0.02em",  "use": "section h2" },
    "displayS":    { "font": "display", "size": "clamp(30px, 3vw, 42px)",   "weight": 200, "leading": 1.15, "tracking": "-0.015em", "use": "feature deep-dive h3" },
    "headingM":    { "font": "display", "size": "30px", "weight": 300, "leading": 1.2,  "use": "how-it-works step title" },
    "headingS":    { "font": "display", "size": "26px", "weight": 300, "leading": 1.25, "use": "why-it-matters card title" },
    "headingXS":   { "font": "display", "size": "24px", "weight": 300, "leading": 1.3,  "use": "FAQ question" },
    "statL":       { "font": "display", "size": "52px", "weight": 200, "leading": 1.0,  "use": "price" },
    "statM":       { "font": "display", "size": "46px", "weight": 200, "leading": 1.0,  "use": "stats band figure" },
    "lead":        { "font": "body", "size": "19px",   "weight": 300, "leading": 1.65, "use": "hero subhead, section lead" },
    "bodyL":       { "font": "body", "size": "17px",   "weight": 300, "leading": 1.7,  "use": "feature paragraph" },
    "bodyM":       { "font": "body", "size": "16px",   "weight": 300, "leading": 1.7,  "use": "step and method paragraph" },
    "bodyS":       { "font": "body", "size": "15.5px", "weight": 300, "leading": 1.7,  "use": "card paragraph" },
    "bodyXS":      { "font": "body", "size": "13px",   "weight": 300, "leading": 1.7,  "use": "footer disclaimer" },
    "monoEyebrow": { "font": "mono", "size": "11.5px", "weight": 400, "tracking": "0.22em", "transform": "uppercase", "use": "hero eyebrow" },
    "monoSection": { "font": "mono", "size": "11px",   "weight": 400, "tracking": "0.2em",  "transform": "uppercase", "use": "numbered section label" },
    "monoLabel":   { "font": "mono", "size": "11px",   "weight": 400, "tracking": "0.16em", "transform": "uppercase", "use": "feature kicker, tile label" },
    "monoTile":    { "font": "mono", "size": "10.5px", "weight": 400, "tracking": "0.16em", "transform": "uppercase", "use": "metric strip label" },
    "monoNav":     { "font": "mono", "size": "12.5px", "weight": 400, "tracking": "0.08em", "transform": "uppercase", "use": "nav link" },
    "monoAction":  { "font": "mono", "size": "14px",   "weight": 500, "tracking": "0.04em", "use": "button label" },
    "monoData":    { "font": "mono", "size": "26px",   "weight": 400, "use": "metric strip value" },
    "monoCaption": { "font": "mono", "size": "12px",   "weight": 400, "use": "chart legend, side annotations" }
  },

  "space": {
    "$comment": "4px base. Section rhythm is the only place large values appear.",
    "1": "4px", "2": "8px", "3": "12px", "4": "16px", "5": "20px", "6": "24px",
    "7": "28px", "8": "32px", "9": "40px", "10": "48px", "12": "60px",
    "14": "70px", "16": "80px", "18": "90px", "20": "130px", "24": "150px", "28": "170px"
  },

  "layout": {
    "maxWidth": "1240px",
    "gutter": "clamp(20px, 3vw, 40px)",
    "sectionPadY": "150px",
    "sectionPadYBand": "130px",
    "navHeight": "72px",
    "labelColumn": "clamp(150px, 18vw, 300px)",
    "sectionGap": "clamp(28px, 4.5vw, 90px)",
    "$comment": "Every two-column section is [labelColumn, minmax(0,1fr)]. Never a bare fixed px track — see README > Responsive rules."
  },

  "radius": { "xs": "4px", "sm": "5px", "md": "6px", "lg": "8px", "xl": "10px", "2xl": "12px" },

  "shadow": {
    "plate":     "0 90px 160px -60px rgba(0,0,0,0.95), 0 0 0 1px rgba(255,255,255,0.02) inset, 0 -1px 0 rgba(255,255,255,0.04) inset",
    "card":      "0 40px 90px -50px rgba(0,0,0,0.9)",
    "action":    "0 18px 44px -18px rgba(79,216,160,0.55)",
    "actionHover": "0 24px 54px -18px rgba(79,216,160,0.7)",
    "tier":      "0 40px 90px -50px rgba(79,216,160,0.3)",
    "hairline":  "0 0 0 1px #241D16",
    "$comment": "hairline is a RING, not a drop shadow — it is how grid cells draw their own dividers. See README > Known trap #2."
  },

  "motion": {
    "reveal":        { "duration": "900ms", "easing": "cubic-bezier(.16,1,.3,1)", "offsetY": "22px", "staggerStep": "90ms", "staggerMax": "360ms" },
    "hoverLift":     { "duration": "200ms", "easing": "ease", "translateY": "-2px" },
    "surfaceTint":   { "duration": "300ms", "easing": "ease" },
    "navTransition": { "duration": "300ms", "easing": "ease", "blur": "blur(20px) saturate(1.2)" },
    "parallaxRange": 190,
    "$comment": "parallaxRange is px of travel at speed 1.0 and intensity 1.0. Element travel = -centerOffsetRatio * speed * parallaxRange * intensity."
  },

  "smoke": {
    "$comment": "Inputs to smoke-field.ts. The ramp is the espresso gradient; everything else shapes the plume.",
    "ramp": [
      [0.00, "#0A0807"],
      [0.42, "#1A130E"],
      [0.62, "#342216"],
      [0.80, "#5C391F"],
      [0.92, "#8A582F"],
      [1.00, "#B07A46"]
    ],
    "gridWidth": 108,
    "gridHeight": 66,
    "outputWidth": 520,
    "fps": 24,
    "octaves": 3,
    "timeStep": 0.0055,
    "riseSpeed": 1.6,
    "swirl": 2.4,
    "floor": 0.28,
    "contrast": 2.2,
    "spread": 1.45,
    "blur": 9
  }
}
